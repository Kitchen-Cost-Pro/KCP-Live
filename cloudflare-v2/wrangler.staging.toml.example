# Copy to wrangler.staging.toml and replace the central D1 database id before staging deployment.
account_id = "cfd7b868a65d660879a7b8597fb15676"
name = "kcp-api-v2-staging"
main = "src/index.ts"
compatibility_date = "2026-05-23"

[alias]
xlsx = "./node_modules/xlsx/xlsx.mjs"
jspdf = "./node_modules/jspdf/dist/jspdf.es.min.js"
jspdf-autotable = "./node_modules/jspdf-autotable/dist/jspdf.plugin.autotable.mjs"

[[durable_objects.bindings]]
name = "WORKSPACE"
class_name = "WorkspaceDO"

[[durable_objects.bindings]]
name = "YOCO_V2_RATE_GATE"
class_name = "YocoV2RateGateDO"

[[durable_objects.bindings]]
name = "YOCO_V2_WRITE_BUDGET"
class_name = "YocoV2WriteBudgetDO"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["WorkspaceDO"]

[[migrations]]
tag = "v2-yoco-rate-gate"
new_sqlite_classes = ["YocoV2RateGateDO"]

[[migrations]]
tag = "v3-yoco-write-budget"
new_sqlite_classes = ["YocoV2WriteBudgetDO"]

[triggers]
crons = ["*/15 * * * *", "*/45 * * * *"]

[[d1_databases]]
binding = "CENTRAL_DB"
database_name = "kcp_central_staging"
database_id = "REPLACE_WITH_STAGING_D1_DATABASE_ID"

[[queues.producers]]
binding = "YOCO_V2_EVENTS"
queue = "kcp-yoco-v2-events-staging"

[[queues.producers]]
binding = "YOCO_V2_EVENTS_DLQ"
queue = "kcp-yoco-v2-events-dlq-staging"

[[queues.consumers]]
queue = "kcp-yoco-v2-events-staging"
max_batch_size = 10
max_batch_timeout = 5
max_retries = 8
dead_letter_queue = "kcp-yoco-v2-events-dlq-staging"

[vars]
ENVIRONMENT = "staging"
YOCO_V2_CAPTURE_ENABLED = "false"
YOCO_V2_QUEUE_ENABLED = "false"
YOCO_V2_ADMIN_ENABLED = "false"
YOCO_V2_SHADOW_SALES_ENABLED = "false"
YOCO_V2_SHADOW_REFUNDS_ENABLED = "false"
YOCO_V2_LIVE_SALE_REPORTING = "false"
YOCO_V2_LIVE_SALE_STOCK = "false"
YOCO_V2_LIVE_REFUND_REPORTING = "false"
YOCO_V2_LIVE_REFUND_STOCK = "false"
YOCO_V2_LEGACY_SHUTDOWN_ENABLED = "false"
YOCO_V2_OBSERVATION_MIN_HOURS = "168"
YOCO_V2_PHASE13_REMOVAL_ENABLED = "false"
YOCO_V2_MAX_ATTEMPTS = "8"
YOCO_V2_BASE_RETRY_MS = "5000"
YOCO_V2_MAX_RETRY_MS = "900000"
YOCO_V2_API_TIMEOUT_MS = "15000"
YOCO_V2_REQUEST_SPACING_MS = "250"
YOCO_V2_ORDER_CACHE_TTL_MS = "30000"
YOCO_V2_AUTH_FAILURE_THRESHOLD = "2"
YOCO_V2_RATE_LIMIT_PAUSE_FALLBACK_MS = "30000"
YOCO_V2_RECONCILIATION_OVERLAP_MINUTES = "120"
YOCO_V2_RECONCILIATION_LOOKBACK_HOURS = "24"
YOCO_V2_REFUND_CACHE_TTL_MS = "20000"
YOCO_V2_METADATA_CACHE_TTL_MS = "60000"
YOCO_V2_WRITE_BUDGET_DAILY_CAP = "90000"
YOCO_V2_WRITE_BUDGET_SOFT_WARN_RATIO = "0.8"

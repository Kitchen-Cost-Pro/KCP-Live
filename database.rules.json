{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        "profile": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (auth.uid === $uid || root.child('adminConfig').child('superusers').child(auth.uid).exists())",
          "workspaces": {
            "$workspaceId": {
              ".write": "auth != null && (auth.uid === $uid || root.child('adminConfig').child('superusers').child(auth.uid).exists() || root.child('workspaces').child($workspaceId).child('data').child('team').child(auth.uid).child('role').val() === 'admin' || root.child('workspaces').child($workspaceId).child('data').child('team').child(auth.uid).child('role').val() === 'owner')",
              ".validate": "!newData.exists() || newData.hasChildren(['role'])"
            }
          }
        }
      }
    },

    "adminConfig": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('adminConfig').child('superusers').child(auth.uid).exists()"
    },

    "systemLogs": {
      ".read": "auth != null && root.child('adminConfig').child('superusers').child(auth.uid).exists()",
      ".write": "auth != null"
    },

    "invitations": {
      ".read": "auth != null",
      "$inviteKey": {
        ".write": "auth != null"
      }
    },

    "signupRequests": {
      ".read": "auth != null",
      "$requestKey": {
        ".write": "auth != null",
        ".validate": "!newData.exists() || newData.hasChildren(['email', 'siteName', 'status'])"
      }
    },

    "adminNotifications": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "workspaces": {
      "$workspaceId": {
        "profile": {
          ".read": "auth != null && (root.child('adminConfig').child('superusers').child(auth.uid).exists() || root.child('users').child(auth.uid).child('profile').child('workspaces').child($workspaceId).exists() || root.child('workspaces').child($workspaceId).child('data').child('team').child(auth.uid).exists())",
          ".write": "auth != null && root.child('adminConfig').child('superusers').child(auth.uid).exists()",
          "linkedSites": {
            ".indexOn": ["siteId", "linkType", "orgId", "corpId"]
          }
        },

        "dashboard_live_state": {
          ".read": "auth != null && (root.child('adminConfig').child('superusers').child(auth.uid).exists() || root.child('users').child(auth.uid).child('profile').child('workspaces').child($workspaceId).exists() || root.child('workspaces').child($workspaceId).child('data').child('team').child(auth.uid).exists())",
          ".write": "auth != null && (root.child('adminConfig').child('superusers').child(auth.uid).exists() || root.child('workspaces').child($workspaceId).child('data').child('team').child(auth.uid).child('role').val() === 'super' || root.child('workspaces').child($workspaceId).child('data').child('team').child(auth.uid).child('role').val() === 'super-user' || root.child('workspaces').child($workspaceId).child('data').child('team').child(auth.uid).child('role').val() === 'superuser' || root.child('workspaces').child($workspaceId).child('data').child('team').child(auth.uid).child('role').val() === 'root' || root.child('users').child(auth.uid).child('profile').child('workspaces').child($workspaceId).child('role').val() === 'super' || root.child('users').child(auth.uid).child('profile').child('workspaces').child($workspaceId).child('role').val() === 'super-user' || root.child('users').child(auth.uid).child('profile').child('workspaces').child($workspaceId).child('role').val() === 'superuser' || root.child('users').child(auth.uid).child('profile').child('workspaces').child($workspaceId).child('role').val() === 'root')"
        },

        "data": {
          ".read": "auth != null && (root.child('adminConfig').child('superusers').child(auth.uid).exists() || root.child('users').child(auth.uid).child('profile').child('workspaces').child($workspaceId).exists() || root.child('workspaces').child($workspaceId).child('data').child('team').child(auth.uid).exists())",
          ".write": "auth != null && (root.child('adminConfig').child('superusers').child(auth.uid).exists() || root.child('users').child(auth.uid).child('profile').child('workspaces').child($workspaceId).exists() || root.child('workspaces').child($workspaceId).child('data').child('team').child(auth.uid).exists())",

          "team": {
            ".read": "auth != null && (root.child('adminConfig').child('superusers').child(auth.uid).exists() || root.child('users').child(auth.uid).child('profile').child('workspaces').child($workspaceId).exists() || root.child('workspaces').child($workspaceId).child('data').child('team').child(auth.uid).exists())",
            "$memberKey": {
              ".write": "auth != null && (root.child('adminConfig').child('superusers').child(auth.uid).exists() || (root.child('users').child(auth.uid).child('profile').child('workspaces').child($workspaceId).exists() || root.child('workspaces').child($workspaceId).child('data').child('team').child(auth.uid).exists()) || (!data.exists() && $memberKey === auth.uid) || !newData.exists())"
            }
          },

          "settings": {},

          "integrations": {},

          "locations": {},

          "customRoles": {
            ".write": "auth != null && (root.child('workspaces').child($workspaceId).child('data').child('team').child(auth.uid).child('role').val() === 'admin' || root.child('workspaces').child($workspaceId).child('data').child('team').child(auth.uid).child('role').val() === 'owner')"
          },

          "ingredients": {
            ".indexOn": ["name", "category", "updatedAt"]
          },

          "products": {
            ".indexOn": ["name", "category", "updatedAt", "source", "status"]
          },

          "suppliers": {
            ".indexOn": ["name", "status", "updatedAt"]
          },

          "purchaseOrders": {
            ".indexOn": ["date", "status", "createdAt", "updatedAt"]
          },

          "logs_grv": {
            ".indexOn": ["timestamp", "date", "createdAt", "supplierId", "locationId"]
          },

          "logs_cn": {
            ".indexOn": ["timestamp", "date", "createdAt", "supplierId", "locationId"]
          },

          "logs_adj": {
            ".indexOn": ["timestamp", "date", "createdAt", "stockItemId", "locationId"]
          },

          "logs_transfers": {
            ".indexOn": ["timestamp", "date", "createdAt", "fromLocationId", "toLocationId"]
          },

          "logs_sales": {
            ".indexOn": ["timestamp", "date", "sourceProvider", "orderId"]
          },

          "logs_sales_errors": {
            ".indexOn": ["timestamp", "sourceProvider", "type"]
          },

          "logs_stocktakes": {
            ".indexOn": ["timestamp", "date", "createdAt", "locationId", "status"]
          },

          "stocktakeTemplates": {},

          "stocktakeDrafts": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              "$draftId": {
                ".write": "auth != null && auth.uid === $uid"
              }
            }
          },

          "logs_mfg": {
            ".indexOn": ["timestamp", "date", "createdAt", "locationId", "manufacturedItemId"]
          },

          "logs_snapshots": {
            ".indexOn": ["timestamp", "date", "createdAt"]
          },

          "sessionOpeningStock": {},

          "processedSalesSignatures": {},

          "dashboardMetrics": {}
        }
      }
    }
  }
}

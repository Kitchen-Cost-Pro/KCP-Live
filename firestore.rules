rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasWorkspaceId(data) {
      return data.workspaceId is string && data.workspaceId.size() > 0;
    }

    function sameWorkspace(resourceData, requestData) {
      return hasWorkspaceId(resourceData)
        && hasWorkspaceId(requestData)
        && resourceData.workspaceId == requestData.workspaceId;
    }

    function isOwnUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create, read, update, delete: if isOwnUserDoc(userId);
    }

    match /menu_items/{itemId} {
      allow read: if signedIn() && hasWorkspaceId(resource.data);
      allow create: if signedIn() && hasWorkspaceId(request.resource.data);
      allow update: if signedIn() && sameWorkspace(resource.data, request.resource.data);
      allow delete: if signedIn() && hasWorkspaceId(resource.data);
    }

    match /suppliers/{supplierId} {
      allow read: if signedIn() && hasWorkspaceId(resource.data);
      allow create: if signedIn() && hasWorkspaceId(request.resource.data);
      allow update: if signedIn() && sameWorkspace(resource.data, request.resource.data);
      allow delete: if signedIn() && hasWorkspaceId(resource.data);
    }

    match /recipes/{recipeId} {
      allow read: if signedIn() && hasWorkspaceId(resource.data);
      allow create: if signedIn() && hasWorkspaceId(request.resource.data);
      allow update: if signedIn() && sameWorkspace(resource.data, request.resource.data);
      allow delete: if signedIn() && hasWorkspaceId(resource.data);
    }

    match /purchase_orders/{purchaseOrderId} {
      allow read: if signedIn() && hasWorkspaceId(resource.data);
      allow create: if signedIn() && hasWorkspaceId(request.resource.data);
      allow update: if signedIn() && sameWorkspace(resource.data, request.resource.data);
      allow delete: if signedIn() && hasWorkspaceId(resource.data);
    }

    match /integrationSecrets/{secretId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
